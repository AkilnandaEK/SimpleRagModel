# ─────────────────────────────────────────────────────────────────
# RAG System — Environment Configuration (template)
# Copy to .env and fill in real values:  Copy-Item .env.example .env
# ─────────────────────────────────────────────────────────────────

# Active LLM provider: "gemini" or "groq"
LLM_PROVIDER=gemini

# Your Google Gemini API key (required when LLM_PROVIDER=gemini)
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model to use for answer generation
GEMINI_MODEL=gemini-2.0-flash

# Groq API key (required when LLM_PROVIDER=groq)
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Groq model to use for answer generation
GROQ_MODEL=llama-3.3-70b-versatile

# sentence-transformers model for local embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB persistence directory (relative to project root)
CHROMA_PERSIST_DIR=./chroma_db

# Chunking settings
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# How many top-K chunks to retrieve per query
TOP_K=5

# Golden set used by /eval/* endpoints
GOLDEN_SET_PATH=./eval/golden_set.sdk-v3.json
